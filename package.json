{
  "name": "hazeljs",
  "version": "2.0.0",
  "private": true,
  "description": "HazelJS monorepo - A modern, TypeScript-first Node.js framework",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:tier1 && npm run build:tier2 && npm run build:tier3",
    "build:core": "npm run build --workspace=@hazeljs/core",
    "build:tier1": "npm run build --workspace=@hazeljs/prompts --workspace=@hazeljs/cache --workspace=@hazeljs/config --workspace=@hazeljs/distributed-lock --workspace=@hazeljs/feature-toggle --workspace=@hazeljs/auth --workspace=@hazeljs/flow --workspace=@hazeljs/flow-runtime --workspace=@hazeljs/oauth --workspace=@hazeljs/payment --workspace=@hazeljs/cron --workspace=@hazeljs/event-emitter --workspace=@hazeljs/graphql --workspace=@hazeljs/grpc --workspace=@hazeljs/queue --workspace=@hazeljs/kafka --workspace=@hazeljs/pubsub --workspace=@hazeljs/prisma --workspace=@hazeljs/typeorm --workspace=@hazeljs/swagger --workspace=@hazeljs/websocket --workspace=@hazeljs/serverless --workspace=@hazeljs/resilience --workspace=@hazeljs/discovery --workspace=@hazeljs/gateway --workspace=@hazeljs/eval --workspace=@hazeljs/benchmark --workspace=@hazeljs/cli --workspace=@hazeljs/i18n --workspace=@hazeljs/inspector --workspace=@hazeljs/worker --workspace=@hazeljs/observability --workspace=@hazeljs/mcp --workspace=@hazeljs/casl",
    "build:tier2": "npm run build --workspace=@hazeljs/memory --workspace=@hazeljs/ai --workspace=@hazeljs/audit --workspace=@hazeljs/data --workspace=@hazeljs/ml --workspace=@hazeljs/rag --workspace=@hazeljs/saga --workspace=@hazeljs/guardrails --workspace=@hazeljs/pdf-to-audio --workspace=@hazeljs/messaging --workspace=@hazeljs/realtime",
    "build:tier3": "npm run build --workspace=@hazeljs/agent && npm run build --workspace=@hazeljs/skillgate && npm run build --workspace=@hazeljs/ops-agent && npm run build --workspace=@hazeljs/testing",
    "build:packages": "npm run build --workspaces --if-present",
    "publish:all": "npm run publish:core && npm run publish:tier1 && npm run publish:tier2 && npm run publish:tier3",
    "publish:core": "npm publish --workspace=@hazeljs/core --access public --tag latest",
    "publish:tier1": "npm publish --workspace=@hazeljs/prompts --workspace=@hazeljs/cache --workspace=@hazeljs/config --workspace=@hazeljs/distributed-lock --workspace=@hazeljs/feature-toggle --workspace=@hazeljs/auth --workspace=@hazeljs/flow --workspace=@hazeljs/flow-runtime --workspace=@hazeljs/oauth --workspace=@hazeljs/payment --workspace=@hazeljs/cron --workspace=@hazeljs/event-emitter --workspace=@hazeljs/graphql --workspace=@hazeljs/grpc --workspace=@hazeljs/queue --workspace=@hazeljs/kafka --workspace=@hazeljs/pubsub --workspace=@hazeljs/prisma --workspace=@hazeljs/typeorm --workspace=@hazeljs/swagger --workspace=@hazeljs/websocket --workspace=@hazeljs/serverless --workspace=@hazeljs/resilience --workspace=@hazeljs/discovery --workspace=@hazeljs/gateway --workspace=@hazeljs/eval --workspace=@hazeljs/benchmark --workspace=@hazeljs/cli --workspace=@hazeljs/i18n --workspace=@hazeljs/inspector --workspace=@hazeljs/worker --workspace=@hazeljs/observability --workspace=@hazeljs/mcp --workspace=@hazeljs/casl --access public --tag latest",
    "publish:tier2": "npm publish --workspace=@hazeljs/memory --workspace=@hazeljs/ai --workspace=@hazeljs/audit --workspace=@hazeljs/data --workspace=@hazeljs/ml --workspace=@hazeljs/rag --workspace=@hazeljs/saga --workspace=@hazeljs/guardrails --workspace=@hazeljs/pdf-to-audio --workspace=@hazeljs/messaging --workspace=@hazeljs/realtime --access public --tag latest",
    "publish:tier3": "npm publish --workspace=@hazeljs/agent --workspace=@hazeljs/skillgate --workspace=@hazeljs/ops-agent --workspace=@hazeljs/testing --access public --tag latest",
    "lerna:version": "lerna version --no-push --no-git-tag-version",
    "lerna:publish": "lerna publish from-package --dist-tag latest",
    "lerna:publish:latest": "lerna publish from-package",
    "version:bump": "node scripts/bump-version.js",
    "version:patch": "lerna version patch --no-push",
    "version:minor": "lerna version minor --no-push",
    "version:major": "lerna version major --no-push",
    "test": "npm run test --workspaces --if-present && npm run test:integration",
    "test:integration": "cd tests/integration && npm test",
    "test:ci": "npm run test:ci --workspaces --if-present && npm run test:integration",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\" \"!packages/cli/cli-manifest.json\"",
    "codegen": "sh -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://127.0.0.1:5432/hazeljs_typecheck}\" && npm run prisma:generate --workspace=@hazeljs/prisma && npm run prisma:generate --workspace=@hazeljs/memory && npm run prisma:generate --workspace=@hazeljs/flow'",
    "typecheck": "npm run codegen && tsc -b",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "prisma:generate": "ts-node scripts/migrate.ts generate",
    "prisma:migrate": "ts-node scripts/migrate.ts migrate",
    "prisma:studio": "ts-node scripts/migrate.ts studio",
    "prisma:reset": "ts-node scripts/migrate.ts reset",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:logs": "docker-compose logs -f",
    "flow:migrate": "npm run prisma:migrate --workspace=@hazeljs/flow",
    "flow:test": "npm run test --workspace=@hazeljs/flow",
    "flow:runtime": "npm run dev --workspace=@hazeljs/flow-runtime"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hazel-js/hazeljs.git"
  },
  "keywords": [
    "hazeljs",
    "framework",
    "typescript",
    "nodejs",
    "monorepo"
  ],
  "author": "Muhammad Arslan <muhammad.arslan@hazeljs.ai>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/hazel-js/hazeljs/issues"
  },
  "homepage": "https://hazeljs.ai",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/hazeljs"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/chalk": "^0.4.31",
    "@types/dotenv": "^6.1.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.39",
    "@types/supertest": "^6.0.3",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lerna": "8.2.4",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=7.0.0"
  }
}
