{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": ".",
    "noEmit": true,
    "types": ["jest", "node"],
    "paths": {
      "@hazeljs/eval": ["src/testing/mocks/hazeljs-eval.ts"],
      "@hazeljs/prompts": ["../prompts/src"],
      "@hazeljs/rag": ["../rag/src"],
      "@hazeljs/resilience": ["../resilience/src"]
