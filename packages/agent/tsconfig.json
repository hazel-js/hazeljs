{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@hazeljs/eval": ["../eval/dist/index.d.ts"],
      "@hazeljs/prompts": ["../prompts/src"],
      "@hazeljs/rag": ["../rag/src"],
      "@hazeljs/resilience": ["../resilience/src"]
    },
    "types": ["jest", "node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../prompts"
    },
    {
      "path": "../rag"
    },
    {
      "path": "../resilience"
    },
    {
      "path": "../eval"
    }
  ]
}
