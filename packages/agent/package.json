{
  "name": "@hazeljs/agent",
  "version": "2.0.2",
  "description": "AI-native Agent Runtime for HazelJS - stateful, long-running agents with tools, memory, and human-in-the-loop",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "test": "jest --coverage --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "keywords": [
    "hazeljs",
    "agent",
    "ai-agent",
    "llm",
    "agentic",
    "agent-runtime",
    "tools",
    "memory",
    "human-in-the-loop"
  ],
  "author": "Muhammad Arslan <muhammad.arslan@hazeljs.ai>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hazel-js/hazeljs",
    "directory": "packages/agent"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "yaml": "^2.8.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@hazeljs/core": "^2.0.2",
    "@hazeljs/eval": "^2.0.2",
    "@hazeljs/prompts": "^2.0.2",
    "@hazeljs/rag": "^2.0.2",
    "@hazeljs/resilience": "^2.0.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.39",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@hazeljs/core": "^2.0.2",
    "@hazeljs/eval": "^2.0.2",
    "@hazeljs/flow": "^2.0.2",
    "@hazeljs/guardrails": "^2.0.2",
    "@hazeljs/observability": "^2.0.2",
    "@hazeljs/prompts": "^2.0.2",
    "@hazeljs/rag": "^2.0.2",
    "@hazeljs/resilience": "^2.0.2",
    "@opentelemetry/api": "^1.9.0",
    "redis": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@hazeljs/eval": {
      "optional": true,
      "description": "Agent trajectory evaluation helpers"
    },
    "redis": {
      "optional": true,
      "description": "Required for RedisStateManager"
    },
    "@prisma/client": {
      "optional": true,
      "description": "Required for DatabaseStateManager and createSqlDurableRunStore (any Prisma SQL provider)"
    },
    "@hazeljs/guardrails": {
      "optional": true,
      "description": "Optional guardrails for tool input/output validation"
    },
    "@hazeljs/observability": {
      "optional": true,
      "description": "OpenTelemetry spans and LLM cost tracking"
    },
    "@hazeljs/flow": {
      "optional": true,
      "description": "Optional FlowEngine peer for durable HITL wait/resume bridge (ADR-003)"
    },
    "@opentelemetry/api": {
      "optional": true,
      "description": "OpenTelemetry API for agent execution spans"
    }
  },
  "bugs": {
    "url": "https://github.com/hazel-js/hazeljs/issues"
  },
  "homepage": "https://hazeljs.ai",
  "gitHead": "083b94562940a86c8e0a8cd81988d04b541608ac"
}
