{
  "name": "@hazeljs/self-healing",
  "version": "2.0.6",
  "description": "Self-healing microservices for HazelJS - error diagnosis, auto-rollback, memory guard, and recovery strategies",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --coverage --passWithNoTests",
    "test:ci": "jest --coverage --coverageReporters=text --coverageReporters=lcov --coverageReporters=clover --no-coverage-threshold",
    "test:watch": "jest --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "@hazeljs/core": "^2.0.6",
    "@hazeljs/resilience": "^2.0.6",
    "@hazeljs/ai": "^2.0.6",
    "@hazeljs/ops-agent": "^2.0.6"
  },
  "peerDependenciesMeta": {
    "@hazeljs/resilience": {
      "optional": true
    },
    "@hazeljs/ai": {
      "optional": true
    },
    "@hazeljs/ops-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hazeljs/core": "^2.0.6",
    "@hazeljs/resilience": "^2.0.6",
    "@hazeljs/ai": "^2.0.6",
    "@hazeljs/ops-agent": "^2.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
