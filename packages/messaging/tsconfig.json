{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@hazeljs/core": ["../core/src"],
      "@hazeljs/ai": ["../ai/src"],
      "@hazeljs/rag": ["../rag/src"],
      "@hazeljs/kafka": ["../kafka/src"]
    },
    "types": ["jest", "node", "reflect-metadata"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../core" },
    { "path": "../ai" },
    { "path": "../rag" },
    { "path": "../kafka" }
  ]
}
