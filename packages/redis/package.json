{
  "name": "@hazeljs/redis",
  "version": "2.0.13",
  "description": "Shared Redis client and pub/sub module for HazelJS — horizontal fan-out, shared connections",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --coverage --passWithNoTests",
    "test:ci": "jest --coverage --coverageReporters=text --coverageReporters=lcov --coverageReporters=clover --no-coverage-threshold",
    "test:watch": "jest --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@hazeljs/core": "^2.0.13",
    "@types/ioredis-mock": "^8.2.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^8.57.1",
    "ioredis": "^5.10.1",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@hazeljs/core": "^2.0.13",
    "ioredis": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": false,
      "description": "Required for Redis connectivity"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hazel-js/hazeljs",
    "directory": "packages/redis"
  },
  "keywords": [
    "hazeljs",
    "redis",
    "ioredis",
    "pubsub",
    "pub-sub",
    "fan-out"
  ],
  "author": "Muhammad Arslan <muhammad.arslan@hazeljs.ai>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/hazel-js/hazeljs/issues"
  },
  "homepage": "https://hazeljs.ai"
}
