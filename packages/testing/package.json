{
  "name": "@hazeljs/testing",
  "version": "2.0.4",
  "description": "Agent testing DSL for HazelJS Agent OS — describeAgent, CI thresholds on top of @hazeljs/eval",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --coverage --passWithNoTests",
    "test:ci": "jest --coverage --coverageReporters=text --coverageReporters=lcov --no-coverage-threshold",
    "lint": "eslint \"src/**/*.ts\" --ignore-pattern \"**/*.d.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --ignore-pattern \"**/*.d.ts\" --fix",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hazeljs/eval": "^2.0.4"
  },
  "peerDependencies": {
    "@hazeljs/agent": "^2.0.4"
  },
  "peerDependenciesMeta": {
    "@hazeljs/agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hazeljs/agent": "^2.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.39",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hazel-js/hazeljs",
    "directory": "packages/testing"
  },
  "keywords": [
    "hazeljs",
    "testing",
    "agent",
    "describeAgent",
    "eval"
  ],
  "homepage": "https://hazeljs.ai",
  "author": "Muhammad Arslan <muhammad.arslan@hazeljs.ai>",
  "license": "Apache-2.0"
}
