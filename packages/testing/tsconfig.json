{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@hazeljs/eval": ["../eval/src/index.ts"],
      "@hazeljs/agent": ["../agent/src/index.ts"]
    },
    "types": ["jest", "node", "reflect-metadata"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"],
  "references": [{ "path": "../eval" }, { "path": "../agent" }]
}
