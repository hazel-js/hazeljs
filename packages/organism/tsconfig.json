{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@hazeljs/agent": ["../agent/src/index.ts"],
      "@hazeljs/core": ["../core/src/index.ts"]
    },
    "types": ["jest", "node", "reflect-metadata"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "examples"],
  "references": [
    {
      "path": "../agent"
    },
    {
      "path": "../core"
    }
  ]
}
