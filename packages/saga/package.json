{
  "name": "@hazeljs/saga",
  "version": "0.8.3",
  "description": "Saga pattern implementation for HazelJS - Orchestration and Choreography for distributed transactions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --coverage --passWithNoTests",
    "test:ci": "jest --coverage --coverageReporters=text --coverageReporters=lcov --coverageReporters=clover --no-coverage-threshold",
    "test:watch": "jest --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "@hazeljs/core": "^0.8.3",
    "@hazeljs/event-emitter": "^0.8.3"
  },
  "devDependencies": {
    "@hazeljs/core": "file:../core",
    "@hazeljs/event-emitter": "file:../event-emitter",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.39",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^8.57.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Muhammad Arslan <muhammad.arslan@hazeljs.ai>",
