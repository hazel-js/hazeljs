{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": ".",
    "noEmit": true,
    "paths": {
      "@hazeljs/agent": ["../agent/src"],
      "@hazeljs/agent-gatekeeper": ["../agent-gatekeeper/src"],
      "@hazeljs/skillgate": ["../skillgate/src"],
      "@hazeljs/core": ["../core/src"]
    }
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
