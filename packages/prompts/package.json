{
  "name": "@hazeljs/prompts",
  "version": "2.0.1",
  "description": "Typed, overridable prompt templates for HazelJS AI, RAG, and Agent packages",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --skipLibCheck",
    "test": "jest --coverage --passWithNoTests",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hazel-js/hazeljs",
    "directory": "packages/prompts"
  },
  "keywords": [
    "hazeljs",
    "prompts",
    "prompt-template",
    "llm",
    "ai",
    "rag",
    "agent"
  ],
  "author": "Muhammad Arslan <muhammad.arslan@hazeljs.ai>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/hazel-js/hazeljs/issues"
  },
  "homepage": "https://hazeljs.ai",
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/__tests__/**",
      "!src/index.ts",
      "!src/stores/index.ts",
      "!src/stores/redis.store.ts",
      "!src/stores/database.store.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 80,
        "functions": 90,
        "lines": 90
      }
    }
  },
  "gitHead": "083b94562940a86c8e0a8cd81988d04b541608ac"
}
