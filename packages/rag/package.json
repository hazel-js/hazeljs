{
  "name": "@hazeljs/rag",
  "version": "0.8.2",
  "description": "Retrieval-Augmented Generation (RAG) and vector search for HazelJS framework",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./memory-hazel": {
      "types": "./dist/memory-hazel.d.ts",
      "default": "./dist/memory-hazel.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc --skipLibCheck",
    "test": "jest --config jest.config.js --coverage --passWithNoTests",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "clean": "rm -rf dist && find src -type f \\( -name '*.js' -o -name '*.d.ts' -o -name '*.d.ts.map' \\) -delete 2>/dev/null || true"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "@hazeljs/core": "^0.8.2",
    "@hazeljs/prompts": "^0.8.2",
    "@hazeljs/ai": "^0.8.2",
    "@hazeljs/memory": "^0.8.2",
    "@pinecone-database/pinecone": "^3.0.0",
    "weaviate-ts-client": "^2.0.0",
    "@qdrant/js-client-rest": "^1.9.0",
    "chromadb": "^1.8.0",
    "openai": "^6.0.0",
    "cohere-ai": "^7.0.0",
    "@huggingface/inference": "^2.0.0",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.11.0",
    "cheerio": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@hazeljs/prompts": {
      "optional": true
    },
    "@hazeljs/ai": {
      "optional": true
    },
    "@hazeljs/memory": {
      "optional": true
    },
    "@pinecone-database/pinecone": {
      "optional": true
    },
    "weaviate-ts-client": {
      "optional": true
    },
    "@qdrant/js-client-rest": {
      "optional": true
    },
    "chromadb": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "cohere-ai": {
      "optional": true
    },
    "@huggingface/inference": {
      "optional": true
    },
    "pdf-parse": {
      "optional": true
    },
    "mammoth": {
      "optional": true
    },
    "cheerio": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hazeljs/memory": "file:../memory",
    "@hazeljs/prompts": "file:../prompts",
    "openai": "^6.33.0",
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hazeljs/hazeljs.git",
    "directory": "packages/rag"
  },
  "keywords": [
    "hazeljs",
    "rag",
    "retrieval-augmented-generation",
    "vector-search",
    "embeddings",
    "semantic-search",
    "pinecone",
    "weaviate",
    "qdrant",
    "chromadb",
    "ai",
    "llm"
  ],
  "author": "Muhammad Arslan <muhammad.arslan@hazeljs.ai>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/hazeljs/hazel-js/issues"
  },
  "homepage": "https://hazeljs.ai"
}
