{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declarationMap": true,
    "baseUrl": ".",
    "paths": {
      "@hazeljs/core": ["../core/src"]
    },
    "types": ["jest", "node", "reflect-metadata"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/__tests__/**"],
  "references": [{ "path": "../core" }]
}
