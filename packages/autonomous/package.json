{
  "name": "@hazeljs/autonomous",
  "version": "2.0.15",
  "description": "HazelJS Autonomous Application Runtime — governed observe→decide→approve→execute for ordinary services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --watch",
    "test": "jest --coverage --passWithNoTests",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "example:order-ops": "ts-node --transpile-only examples/autonomous-order-operations/index.ts",
    "demo:failure": "ts-node --transpile-only examples/autonomous-order-operations/demo-failure.ts"
  },
  "keywords": [
    "hazeljs",
    "autonomous",
    "agent-os",
    "governance",
    "durable",
    "capabilities"
  ],
  "author": "Muhammad Arslan <muhammad.arslan@hazeljs.ai>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hazel-js/hazeljs",
    "directory": "packages/autonomous"
  },
  "bugs": {
    "url": "https://github.com/hazel-js/hazeljs/issues"
  },
  "homepage": "https://hazeljs.ai",
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hazeljs/agent": "^2.0.15",
    "@hazeljs/agent-gatekeeper": "^2.0.15",
    "@hazeljs/core": "^2.0.15",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.39",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@hazeljs/agent": "^2.0.15",
    "@hazeljs/agent-gatekeeper": "^2.0.15",
    "@hazeljs/agent-vm": "^2.0.15",
    "@hazeljs/core": "^2.0.15",
    "@hazeljs/decision": "^2.0.15",
    "@hazeljs/event-emitter": "^2.0.15",
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@hazeljs/agent": {
      "optional": true,
      "description": "DurableRunStore / AgentRun bridge for production durability"
    },
    "@hazeljs/agent-vm": {
      "optional": true,
      "description": "Effect journal / compensation for irreversible capabilities"
    },
    "@hazeljs/decision": {
      "optional": true,
      "description": "Decision Plane / DecisionRuntime provider (default is built-in rules engine)"
    },
    "@hazeljs/event-emitter": {
      "optional": true,
      "description": "Bridge application @OnEvent bus into AAR observations"
    },
    "@opentelemetry/api": {
      "optional": true,
      "description": "OpenTelemetry counters for hazel.autonomous.* metrics"
    }
  }
}
