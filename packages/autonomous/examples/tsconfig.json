{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "../dist-examples",
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@hazeljs/core": ["../../core/src"],
      "@hazeljs/autonomous": ["../src"]
    }
  },
  "include": ["./**/*.ts", "../src/**/*.ts"],
  "exclude": ["../dist", "../node_modules"]
}
