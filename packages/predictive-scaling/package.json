{
  "name": "@hazeljs/predictive-scaling",
  "version": "2.0.5",
  "description": "Predictive auto-scaling for HazelJS - traffic forecasting, proactive HPA adjustments, and event-driven scaling",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --coverage --passWithNoTests",
    "test:ci": "jest --coverage --coverageReporters=text --coverageReporters=lcov --coverageReporters=clover --no-coverage-threshold",
    "test:watch": "jest --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "@hazeljs/core": "^2.0.5",
    "@hazeljs/self-healing": "^2.0.5",
    "@hazeljs/ai": "^2.0.5"
  },
  "peerDependenciesMeta": {
    "@hazeljs/self-healing": {
      "optional": true
    },
    "@hazeljs/ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hazeljs/core": "^2.0.5",
    "@hazeljs/self-healing": "^2.0.5",
    "@hazeljs/ai": "^2.0.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hazel-js/hazeljs",
    "directory": "packages/predictive-scaling"
  },
  "keywords": [
    "hazeljs",
