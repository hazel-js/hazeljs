{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declarationMap": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@hazeljs/core": ["../core/src"],
      "@hazeljs/cache": ["../cache/src"],
      "@hazeljs/prompts": ["../prompts/src"],
      "@hazeljs/memory": ["../memory/src"]
    },
    "types": ["jest", "node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/node_modules/openai/src/**"],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../cache"
    },
    {
      "path": "../prompts"
    },
    {
      "path": "../memory"
    }
  ]
}
