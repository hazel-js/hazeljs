{
  "name": "@hazeljs/ai",
  "version": "0.7.3",
  "description": "AI integration module for HazelJS framework",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc --skipLibCheck",
    "test": "jest --coverage --maxWorkers=1",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "demo:simple": "npx tsx examples/simple-demo.ts",
    "demo:full": "npx tsx examples/unified-platform-example.ts",
    "demo:hcel": "npx tsx examples/hcel-demo.ts",
    "demo:production": "npx tsx examples/hcel-production-demo.ts",
    "demo:agent": "npx tsx examples/hcel-agent-demo.ts",
    "demo:flow": "npx tsx examples/hcel-flow-demo.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@google/generative-ai": "^0.24.1",
    "@hazeljs/prompts": ">=0.2.0-beta.0",
    "cohere-ai": "^7.14.0",
    "openai": "^6.15.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.50",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hazel-js/hazeljs.git",
    "directory": "packages/ai"
  },
  "keywords": [
    "hazeljs",
    "ai",
    "openai",
    "anthropic",
    "gemini",
    "llm"
  ],
  "author": "Muhammad Arslan <muhammad.arslan@hazeljs.ai>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/hazeljs/hazel-js/issues"
  },
  "homepage": "https://hazeljs.ai",
  "peerDependencies": {
    "@hazeljs/agent": ">=0.2.0-beta.0",
    "@hazeljs/cache": ">=0.2.0-beta.0",
    "@hazeljs/core": ">=0.2.0-beta.0",
    "@hazeljs/guardrails": ">=0.2.0-beta.0",
    "@hazeljs/memory": ">=0.2.0-beta.0",
    "@hazeljs/ml": ">=0.2.0-beta.0",
    "@hazeljs/prompts": ">=0.2.0-beta.0",
    "@hazeljs/rag": ">=0.2.0-beta.0"
  },
  "peerDependenciesMeta": {
    "@hazeljs/rag": {
      "optional": true
    },
    "@hazeljs/agent": {
      "optional": true
    },
    "@hazeljs/ml": {
      "optional": true
    },
    "@hazeljs/memory": {
      "optional": true
    },
    "@hazeljs/prompts": {
      "optional": true
    },
    "@hazeljs/guardrails": {
      "optional": true
    }
  }
}
