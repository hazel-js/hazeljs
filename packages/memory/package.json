{
  "name": "@hazeljs/memory",
  "version": "2.0.0",
  "description": "Pluggable user memory for HazelJS - profile, preferences, behavioral patterns, emotional state, episodic and semantic memory with multi-store support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prisma": {
      "types": "./dist/prisma.d.ts",
      "default": "./dist/prisma.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "prisma generate && tsc --skipLibCheck",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test": "jest --coverage --passWithNoTests",
    "lint": "eslint \"src/**/*.ts\" --ignore-pattern \"**/*.d.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --ignore-pattern \"**/*.d.ts\" --fix",
    "clean": "rm -rf dist"
  },
  "optionalDependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0",
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hazel-js/hazeljs",
    "directory": "packages/memory"
  },
  "keywords": [
    "hazeljs",
    "memory",
    "user-memory",
    "preferences",
    "episodic",
    "agent",
    "rag",
    "prisma"
  ],
  "author": "Muhammad Arslan <muhammad.arslan@hazeljs.ai>",
  "license": "Apache-2.0",
  "gitHead": "083b94562940a86c8e0a8cd81988d04b541608ac"
}
