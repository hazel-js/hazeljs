{
  "name": "@hazeljs/kag",
  "version": "2.0.12",
  "description": "Knowledge-Augmented Generation for HazelJS — entities, facts, relations, and structured reasoning",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\" --ignore-pattern \"src/bench.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --ignore-pattern \"src/bench.ts\" --fix",
    "clean": "rm -rf dist",
    "bench": "ts-node --transpile-only src/bench.ts"
  },
  "dependencies": {
    "eventemitter3": "^5.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@hazeljs/core": "^2.0.12",
    "@hazeljs/ai": "^2.0.12",
    "@hazeljs/rag": "^2.0.12",
    "@hazeljs/memory": "^2.0.12",
    "@hazeljs/event-emitter": "^2.0.12"
  },
  "peerDependenciesMeta": {
    "@hazeljs/ai": {
      "optional": true
    },
    "@hazeljs/rag": {
      "optional": true
    },
    "@hazeljs/memory": {
      "optional": true
    },
    "@hazeljs/event-emitter": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hazel-js/hazeljs",
    "directory": "packages/kag"
  },
  "keywords": [
    "hazeljs",
    "kag",
    "knowledge-augmented-generation",
    "knowledge-graph",
    "entities",
    "facts"
  ],
  "author": "Muhammad Arslan <muhammad.arslan@hazeljs.ai>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/hazel-js/hazeljs/issues"
  },
  "homepage": "https://hazeljs.ai"
}
