{
  "name": "@hazeljs/cli",
  "version": "0.8.0",
  "description": "Command-line interface for scaffolding and generating HazelJS applications and components",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "@template",
    "@template-ai-native",
    "cli-manifest.json"
  ],
  "bin": {
    "hazel": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/generate-manifest.js",
    "build:types": "tsc",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "npm run build"
  },
  "optionalDependencies": {},
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "inquirer": "^8.2.7",
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "@hazeljs/eval": "file:../eval",
    "@types/inquirer": "^8.2.12",
    "@types/jest": "^29.5.14",
    "@types/mustache": "^4.2.6",
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "hazeljs",
    "cli",
    "generator",
    "scaffolding",
    "code-generator",
    "typescript",
    "framework"
  ],
  "author": "Muhammad Arslan <muhammad.arslan@hazeljs.ai>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hazel-js/hazeljs.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/hazeljs/hazel-js/issues"
  },
  "homepage": "https://hazeljs.ai",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/hazeljs"
  }
}
