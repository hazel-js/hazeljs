        },
        {
          "type": "pipe",
          "description": "Validation/transform pipe",
          "usage": "hazel g pipe <name> [options]",
          "nameRequired": true,
          "options": [
            {
              "name": "path",
              "short": "p",
              "type": "string",
              "description": "Path where the file should be generated"
            },
            {
              "name": "dry-run",
              "type": "boolean",
              "description": "Preview files without writing them"
            },
            {
              "name": "json",
