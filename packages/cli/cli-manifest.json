{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HazelJS CLI Manifest",
  "description": "Machine-readable manifest of all CLI commands and options for LLM agent tool-use",
  "cli": {
    "name": "hazel",
    "version": "0.7.6",
    "description": "CLI for generating HazelJS components and applications"
  },
  "commands": [
    {
      "name": "new",
      "usage": "hazel new <appName> [options]",
      "description": "Create a new HazelJS application with optional interactive setup",
      "args": [
        {
          "name": "appName",
          "type": "string",
          "required": true,
          "description": "Name of the new application"
        }
      ],
      "options": [
        {
          "name": "dest",
          "short": "d",
          "type": "string",
          "default": ".",
          "description": "Destination path"
        },
        {
          "name": "skip-install",
          "type": "boolean",
          "description": "Skip npm install"
        },
        {
          "name": "skip-git",
          "type": "boolean",
          "description": "Skip git initialization"
        },
        {
          "name": "interactive",
          "short": "i",
          "type": "boolean",
          "description": "Interactive setup with package selection"
        },
        {
          "name": "template",
          "short": "t",
          "type": "string",
          "enum": [
            "basic",
            "ai-native"
          ],
          "default": "basic",
          "description": "Project template"
        }
      ],
      "examples": [
        "hazel new my-app",
        "hazel new my-app -i",
        "hazel new my-ai-app --template ai-native"
      ]
    },
    {
      "name": "generate",
      "usage": "hazel generate <type> <name> [options]",
      "description": "Generate HazelJS components. Use --list to see all types",
      "alias": "g",
      "subcommands": [
        {
          "name": "app",
          "usage": "hazel g app <name> [options]",
          "description": "Generate a skeleton HazelJS application (minimal template, no install)",
          "args": [
            {
              "name": "name",
              "type": "string",
              "required": true,
              "description": "Application name"
            }
          ],
          "options": [
            {
              "name": "path",
              "short": "p",
              "type": "string",
              "default": ".",
              "description": "Parent directory for the app"
            },
            {
              "name": "template",
              "short": "t",
              "type": "string",
              "enum": [
                "basic",
                "ai-native"
              ],
              "default": "basic",
              "description": "Project template"
            },
            {
              "name": "dry-run",
              "type": "boolean",
              "description": "Preview without writing files"
            },
            {
              "name": "json",
              "type": "boolean",
              "description": "Output result as JSON"
            }
          ]
        },
        {
          "name": "module",
          "usage": "hazel g module <name> [options]",
          "description": "Generate a new module (with controller, service, DTOs)",
          "alias": "m",
          "args": [
            {
              "name": "name",
              "type": "string",
              "required": true,
              "description": "Module name"
            }
          ],
          "options": [
            {
              "name": "path",
              "short": "p",
              "type": "string",
              "description": "Path where the module should be generated"
            },
            {
              "name": "dry-run",
              "type": "boolean",
              "description": "Preview files without writing them"
            },
            {
              "name": "json",
              "type": "boolean",
              "description": "Output result as JSON"
            }
          ]
        },
        {
          "name": "dto",
          "usage": "hazel g dto <name> [options]",
          "description": "Generate create and update DTOs",
          "alias": "d",
          "args": [
            {
              "name": "name",
              "type": "string",
              "required": true,
              "description": "DTO name"
            }
          ],
          "options": [
            {
              "name": "path",
              "short": "p",
              "type": "string",
              "description": "Path where the DTOs should be generated"
            },
            {
              "name": "dry-run",
              "type": "boolean",
              "description": "Preview files without writing them"
            },
            {
              "name": "json",
              "type": "boolean",
              "description": "Output result as JSON"
            }
          ]
        },
        {
          "name": "crud",
          "usage": "hazel g crud <name> [options]",
          "description": "Generate a complete CRUD resource (controller, service, module, DTOs)",
          "args": [
            {
              "name": "name",
              "type": "string",
              "required": true,
              "description": "Resource name"
            }
          ],
          "options": [
            {
              "name": "path",
              "short": "p",
              "type": "string",
              "default": "src",
              "description": "Specify the path"
            },
            {
              "name": "route",
              "short": "r",
              "type": "string",
              "description": "Specify the route path"
            },
            {
              "name": "dry-run",
              "type": "boolean",
              "description": "Preview files without writing them"
            },
            {
              "name": "json",
              "type": "boolean",
              "description": "Output result as JSON"
            }
          ]
        },
        {
          "name": "auth",
          "usage": "hazel g auth [options]",
          "description": "Generate an auth module with JWT guard, service, controller, and DTOs",
          "args": [],
          "options": [
            {
              "name": "path",
              "short": "p",
              "type": "string",
              "default": "src/auth",
              "description": "Specify the path"
            },
            {
              "name": "dry-run",
              "type": "boolean",
              "description": "Preview files without writing them"
            },
            {
              "name": "json",
              "type": "boolean",
              "description": "Output result as JSON"
            }
          ]
        }
      ],
      "simpleGenerators": [
        {
          "type": "controller",
          "description": "REST controller",
          "alias": "c",
          "usage": "hazel g controller <name> [options]",
          "nameRequired": true,
          "options": [
            {
              "name": "path",
              "short": "p",
              "type": "string",
              "description": "Path where the file should be generated"
            },
            {
              "name": "dry-run",
              "type": "boolean",
              "description": "Preview files without writing them"
            },
            {
              "name": "json",
              "type": "boolean",
              "description": "Output result as JSON"
            }
          ]
        },
        {
          "type": "service",
          "description": "Service class",
          "alias": "s",
          "usage": "hazel g service <name> [options]",
          "nameRequired": true,
          "options": [
            {
              "name": "path",
              "short": "p",
              "type": "string",
              "description": "Path where the file should be generated"
            },
            {
              "name": "dry-run",
              "type": "boolean",
              "description": "Preview files without writing them"
            },
            {
              "name": "json",
              "type": "boolean",
              "description": "Output result as JSON"
            }
          ]
        },
        {
          "type": "guard",
          "description": "Guard (e.g. auth)",
          "alias": "gu",
          "usage": "hazel g guard <name> [options]",
          "nameRequired": true,
          "options": [
            {
              "name": "path",
              "short": "p",
              "type": "string",
              "description": "Path where the file should be generated"
            },
            {
              "name": "dry-run",
              "type": "boolean",
              "description": "Preview files without writing them"
            },
            {
              "name": "json",
              "type": "boolean",
              "description": "Output result as JSON"
            }
          ]
        },
        {
          "type": "interceptor",
          "description": "Interceptor",
          "alias": "i",
          "usage": "hazel g interceptor <name> [options]",
          "nameRequired": true,
          "options": [
            {
              "name": "path",
              "short": "p",
              "type": "string",
              "description": "Path where the file should be generated"
            },
            {
              "name": "dry-run",
              "type": "boolean",
              "description": "Preview files without writing them"
            },
            {
              "name": "json",
              "type": "boolean",
              "description": "Output result as JSON"
            }
