    {
      "name": "add",
      "usage": "hazel add [package] [options]",
      "description": "Add a HazelJS package to your project (optionally generate a setup file with --setup)",
      "args": [
        {
          "name": "package",
          "type": "string",
          "required": false,
          "description": "Package short name (e.g. 'ai', 'auth') or full npm name"
