{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["jest", "node"],
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@hazeljs/eval": ["../eval/src/index.ts"],
      "@hazeljs/agent": ["../agent/src/index.ts"],
      "@hazeljs/benchmark": ["../benchmark/src/index.ts"],
      "@hazeljs/skillgate": ["../skillgate/src/index.ts"],
      "@hazeljs/agent-gatekeeper": ["../agent-gatekeeper/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../eval" },
    { "path": "../agent" },
    { "path": "../benchmark" },
    { "path": "../skillgate" },
    { "path": "../agent-gatekeeper" }
  ]
}
