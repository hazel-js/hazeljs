{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@hazeljs/agent": ["../agent/src"],
      "@hazeljs/ai": ["../ai/src"],
      "@hazeljs/rag": ["../rag/src"]
    },
    "types": ["jest", "node", "reflect-metadata"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "../agent" }, { "path": "../ai" }, { "path": "../rag" }]
}
